.{
    // This is the default name used by packages depending on this one.
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .dns,

    // This is a [Semantic Version](https://semver.org/).
    .version = "0.1.12",

    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*.
    //
    // Changing this has security and trust implications.
    .fingerprint = 0x82eddc41cd3e85c7,

    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.16.0",

    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package.
    .dependencies = .{
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git?ref=v0.1.9#9a30342ba9e01fdb9a99f91d78b98cff4aeca002",
            .hash = "cli-0.1.8-0aso9PrXCQAKO-svaLtH5bJLhRYkQ4E-urpjhpcVD8-F",
        },
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git?ref=v0.1.10#346eece54d4f0ecea0962d85c9a96301edacb8de",
            .hash = "config-0.1.6-TiLumpdUDADqBkfjjufuTkIMWMYESWO1oWr2zqyQ3PIk",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.6#aa4493781d962f42ba1dd37261e0e107be5f6ffe",
            .hash = "thread_pool-0.2.5-11B1BiNceQDdiX2mLCg-blCuvBT0ZHh0_A_gH9j7t2Gl",
        },
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.13#31e4104d698c52758507e444edb1d770151239d6",
            .hash = "otel-0.1.9-B0v3ltPiNQD_qlCLj0oUor4puasXR8KWGfPpaE48icHy",
            .lazy = true,
        },
        // FIPS-140-3 / PQC backend. Resolved only when a build reaches
        // `b.lazyDependency("fips", ...)` under -Dfips=true. With the flag
        // off the dependency is never fetched and the produced artifact
        // links no OpenSSL and contains zero fips symbols.
        //
        // LOCAL PATH dep: the fips package is developed in-tree and has no
        // published remote yet, so it is wired as a path. Zig requires path
        // deps to be relative to the RESOLVED (symlink-followed) build root.
        // In this workspace `devnw/zig/dns` is a symlink into
        // src/gl/gitlab.com/devnw/zig/dns, while the fips checkout lives at
        // the real src/devnw/zig/fips; the relative path below resolves from
        // the resolved dns root to that canonical fips checkout.
        // NOTE: a path dependency cannot be marked `.lazy`; laziness here is
        // enforced by gating the `b.lazyDependency("fips", ...)` CALL behind
        // `if (fips)` in build.zig, so the path is only ever resolved when
        // -Dfips=true.
        //
        // Eventual production (git+https lazy) form once published:
        //   .fips = .{
        //       .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.0#<commit-sha>",
        //       .hash = "<zig-package-hash>",
        //       .lazy = true,
        //   },
        .fips = .{
            .path = "../../../../../devnw/zig/fips",
        },
    },

    // Specifies the set of files and directories that are included in this
    // package.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
