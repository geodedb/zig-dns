.{
    // This is the default name used by packages depending on this one.
    // It is redundant to include "zig" in this name because it is already
    // within the Zig package namespace.
    .name = .dns,

    // This is a [Semantic Version](https://semver.org/).
    .version = "0.1.7",

    // Together with name, this represents a globally unique package
    // identifier. This field is generated by the Zig toolchain when the
    // package is first created, and then *never changes*.
    //
    // Changing this has security and trust implications.
    .fingerprint = 0x82eddc41cd3e85c7,

    // Tracks the earliest Zig version that the package considers to be a
    // supported use case.
    .minimum_zig_version = "0.15.1",

    // Each dependency must either provide a `url` and `hash`, or a `path`.
    // `zig build --fetch` can be used to fetch all dependencies of a package.
    .dependencies = .{
        .cli = .{
            .url = "git+https://gitlab.com/devnw/zig/cli.git#de11f869fe80e56a756b08dbbd28c9807eec6ca1",
            .hash = "cli-0.1.4-0aso9FDBBgCUINdIje3hWx5irh9SLOJwJuSb9mNLAvgU",
        },
        .config = .{
            .url = "git+https://gitlab.com/devnw/zig/config.git#dbf3ceaba175cf196a1ae7806b90bcd5ec0df009",
            .hash = "config-0.1.4-TiLumvdgCgCi-N6NyOTB85Erl-hseWjkXhlhFIz1Aju8",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#39528a3e92212efab8ed5840bc20e619a419c0f5",
            .hash = "thread_pool-0.2.4-11B1BnyUdgCUNlqgBwHNvE4plLwP1s1MAyCjODPafrpo",
        },
        // Otel observability dep. Lazy: only fetched when the build
        // reaches `b.lazyDependency("otel", ...)` under `-Dwith_otel=true`.
        // With the flag off the dependency is never resolved and the
        // produced artifact contains zero otel symbols (verified by
        // otel/scripts/verify-consumer-noop.sh).
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#455ad2b8fb6888d5dab48a0a5bdcc81fd225f635",
            .hash = "otel-0.1.5-B0v3lvEMNAC40_D5FfUJgpR3hR8nP5R4IKg31uJmpk-y",
            .lazy = true,
        },
    },

    // Specifies the set of files and directories that are included in this
    // package.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
